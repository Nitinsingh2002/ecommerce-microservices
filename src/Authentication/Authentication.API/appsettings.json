{
    "ConnectionStrings": {
        "DefautConnection": "Server=.;Database=ECommerce_AuthenticationDb;Trusted_Connection=True;TrustServerCertificate=True;"
    },
    "Jwt": {
        "Issuer": "EcommerceBackend",
        "Audience": "EcommerceClient",
        "SecretKey": "D8xJN5pskZaKF4OxdrLyQOn4yDlSNVnnHJAAY6NbMZc=",
        "AccessTokenExpiryMinutes": 30,
        "RefreshTokenExpiryDays": 7
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "System": "Warning"
            }
        },
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                   "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [CorrelationId: {CorrelationId}] [TraceId: {TraceId}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                   "path": "../../../logs/Authentication/application/application-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "fileSizeLimitBytes": 104857600,
                    "rollOnFileSizeLimit": true,
                    "shared": true,
                    "flushToDiskInterval": "00:00:01",
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [CorrelationId: {CorrelationId}] [TraceId: {TraceId}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "../../../logs/Authentication/error/error-.log",
                    "rollingInterval": "Day",
                    "restrictedToMinimumLevel": "Error",
                    "retainedFileCountLimit": 30,
                    "fileSizeLimitBytes": 104857600,
                    "rollOnFileSizeLimit": true,
                    "shared": true,
                    "flushToDiskInterval": "00:00:01",
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "AllowedHosts": "*"
}